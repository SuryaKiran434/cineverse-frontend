# Copy to .env and fill in. NEVER commit .env.
#
# ⚠️  EVERY VITE_-PREFIXED VARIABLE IS COMPILED INTO THE SHIPPED JAVASCRIPT
#     BUNDLE AND IS READABLE BY ANY VISITOR. Nothing secret may go here.
#     API keys, tokens and passwords belong in the Cineverse backend's .env.

# Base URL of the Cineverse backend. Public by definition — safe to inline.
VITE_API_BASE_URL=http://127.0.0.1:8000
